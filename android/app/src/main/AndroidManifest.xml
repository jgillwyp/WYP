<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links (2026-10-21, owner-reported — an emailed
                 wouldyouplease.com link opens the device's regular browser
                 instead of this installed app). autoVerify="true" has
                 Android check the hosted Digital Asset Links file
                 (public/.well-known/assetlinks.json, served by the web app
                 itself) against this app's own signing certificate at
                 install time; only once that verification succeeds does a
                 matching link open here instead of falling back to the
                 browser the way it always has — an unverified device just
                 keeps today's behavior, nothing regresses either way.
                 singleTask (already set above) means a link tapped while
                 the app is already running reaches the existing instance
                 via onNewIntent rather than opening a second one.
                 PWAProvider.tsx's appUrlOpen listener is what then
                 navigates to the actual tapped path. Both the www and bare
                 apex hosts are declared since the apex 308-redirects to
                 www at the Vercel domain level (see CLAUDE.md's
                 2026-08-22 email-logo entry) — App Links interception
                 happens before that redirect would ever fire. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.wouldyouplease.com" />
                <data android:scheme="https" android:host="wouldyouplease.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice dictation (2026-10-21, owner-reported — the mic button
         blinked red and returned to normal without ever listening,
         then stopped responding at all). Capacitor's own default
         WebChromeClient (BridgeWebChromeClient, wired in automatically
         by Bridge.java — no custom Java code needed) already knows how
         to request RECORD_AUDIO at runtime and grant the WebView's own
         getUserMedia/SpeechRecognition permission request once the user
         approves it. Without this manifest declaration, that runtime
         request has nothing to ask Android for, so it fails silently
         before any system permission dialog can appear — the web page's
         SpeechRecognition call gets an instant denial instead, which
         matches the reported blink-then-nothing behavior exactly.
         MODIFY_AUDIO_SETTINGS is also requested by that same chrome
         client for an audio-capture grant; it's a normal (non-dangerous)
         permission, auto-granted once declared, no prompt involved. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+ (API 30+) package visibility — without this, Intent.
         resolveActivity()/startActivity() can silently fail to find an
         installed Calendar app even when one exists, since the OS hides
         other packages' visibility by default unless declared here.
         NativeCalendarPlugin.java (2026-10-16) needs this for its
         Intent.ACTION_INSERT against CalendarContract.Events.CONTENT_URI. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>
</manifest>
